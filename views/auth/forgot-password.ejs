<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password | PostVisit</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
<div class="auth-layout">
  <div class="auth-panel auth-panel--left">
    <div class="auth-panel__inner">
      <a href="/" class="auth-brand"><div class="auth-brand__icon"><i class="fas fa-heartbeat"></i></div><span>PostVisit</span></a>
      <h1 class="auth-panel__title">Reset your <em>password.</em></h1>
      <p class="auth-panel__sub">Enter your registered email and we will send you a secure reset link valid for 10 minutes.</p>
    </div>
  </div>
  <div class="auth-panel auth-panel--right">
    <div class="auth-form-container">
      <div class="auth-form-header"><h2>Forgot Password</h2><p>We'll send a reset link to your email</p></div>
      <% if (success_msg && success_msg.length > 0) { %><div class="alert alert--success"><i class="fas fa-check-circle"></i> <%=success_msg%></div><% } %>
      <% if (error_msg && error_msg.length > 0) { %><div class="alert alert--error"><i class="fas fa-exclamation-circle"></i> <%=error_msg%></div><% } %>
      <form action="/auth/forgot-password" method="POST" class="auth-form">
        <div class="form-group">
          <label for="email">Email address</label>
          <div class="input-wrapper"><i class="fas fa-envelope"></i><input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email"></div>
        </div>
        <button type="submit" class="btn-auth"><i class="fas fa-paper-plane"></i> Send Reset Link</button>
      </form>
      <p class="auth-switch">Remember it? <a href="/auth/login">Sign in</a></p>
    </div>
  </div>
</div>
</body>
</html>
