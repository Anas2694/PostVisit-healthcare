# ================================
# PostVisit Healthcare Platform
# Environment Configuration
# ================================

# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/postvisit
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/postvisit

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Bcrypt
BCRYPT_ROUNDS=12

# Session
SESSION_SECRET=your_session_secret_key_change_in_production

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 (alternative to Cloudinary)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_BUCKET_NAME=your_bucket_name
# AWS_REGION=us-east-1

# OpenAI (for AI processing)
OPENAI_API_KEY=your_openai_api_key
# Leave empty to use built-in mock AI engine

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=PostVisit Health <noreply@postvisit.health>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# App
APP_NAME=PostVisit
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
